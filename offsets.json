      "pattern": "40 53 48 83 EC 30 48 C7 44 24 20 FE FF FF FF 48 8B D9 B9 28 01 00 00 E8 ? ? ? ? 48 89 44 24 40 48 85 C0 74 13",
      "expect_rva": "0x85E110"
    },
    "NETRANK_BIND": {
