  "patterns": {
    "SET_RESULT_VARIANT": {
      "comment": "sub_3A46D0(screen, variant, holdFrames) - writes +0x1B8/+0x1BC, sets the draw gate +0x1C0=1, and plays the layout's type-0 'in' animation (which sets elem[0x2C] bit 0, the thing that actually makes it render). Relocation-free prefix.",
      "pattern": "48 83 EC 28 89 91 B8 01 00 00 44 89 81 BC 01 00 00",
      "expect_rva": "0x3A46D0"
    },
    "HEAP_PUSH": {
      "comment": "PushHeap(heapId, 0) - scopes the following allocations",
      "pattern": "48 89 5C 24 08 48 89 74 24 10 57 48 83 EC 30 48 63 05",
      "expect_rva": "0x3C6530"
    },
    "HEAP_ALLOC": {
      "comment": "operator new(size)",
      "pattern": "48 89 4C 24 08 57 48 83 EC 30 48 C7 44 24 20 FE FF FF FF 48 89 5C 24 50 48 8B 05",
      "expect_rva": "0x3C6230"
    },
    "HEAP_POP": {
      "comment": "PopHeap()",
